# ==============================================================================
# SOLANA + PUMP.FUN CONFIGURATION
# ==============================================================================
# "devnet" for testing (free SOL from https://faucet.solana.com), "mainnet-beta" for production
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"

# RPC used by the server AND (through the /api/rpc proxy) by the browser, so a private key stays secret.
# Public endpoints are heavily rate limited: use Helius / Triton / QuickNode for production.
SOLANA_RPC_URL=""
# Optional: let browsers talk to an RPC directly instead of /api/rpc (this URL is visible to users).
NEXT_PUBLIC_SOLANA_RPC_URL=""

# Priority fee per compute unit (micro-lamports)
NEXT_PUBLIC_PRIORITY_FEE_MICROLAMPORTS="200000"

# ==============================================================================
# ROBINHOOD CHAIN (CHAIN ID: 4663) + PONS V2 (EVM launches)
# ==============================================================================
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME="Robinhood Chain"
NEXT_PUBLIC_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
NEXT_PUBLIC_BLOCK_EXPLORER_URL="https://robinhoodchain.blockscout.com"

# Server-side Robinhood RPC used by /api/evm-rpc (browsers never call the RPC domain directly)
ROBINHOOD_RPC_URL=""

# Official Pons v2 Contract Addresses
NEXT_PUBLIC_FACTORY_ADDRESS="0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e"
NEXT_PUBLIC_LAUNCH_AND_BUY_ADDRESS="0xe33E9E479dF8802cb0866d5d05258bEc4cF62948"
NEXT_PUBLIC_FEE_ESCROW_ADDRESS="0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e"
NEXT_PUBLIC_BUYBACK_VAULT_ADDRESS="0x42df2a798f82289E177311362e8f5ccC45c1219c"
NEXT_PUBLIC_LAUNCH_LOCKER_ADDRESS="0x267444D099b10fB5Ed7c3Cc7B7c767AdcA574952"
NEXT_PUBLIC_MEME_HOOK_ADDRESS="0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044"

# Public URL of this site (stored as "createdOn" in token metadata)
NEXT_PUBLIC_SITE_URL=""

# IPFS: with PINATA_JWT set, logo + metadata are pinned to Pinata.
# Without it, the app falls back to pump.fun's own IPFS upload endpoint.
PINATA_JWT=""
IPFS_PUBLIC_GATEWAY="https://ipfs.io/ipfs/"

# Optional: catbox.moe user hash for image previews (/api/upload)
CATBOX_USERHASH=""

# Required to remove tokens from the platform registry:
#   curl -X DELETE -H "x-admin-secret: $ADMIN_SECRET" "http://localhost:3000/api/tokens?token=<MINT>"
ADMIN_SECRET=""

# X (Twitter) narrative radar
X_BEARER_TOKEN=""
TWITTER_BEARER_TOKEN=""
TWITTERAPI_WEBHOOK_SECRET=""
X_TARGET_ACCOUNTS="elonmusk,VitalikButerin,cz_binance,whale_alert"
